# Sensor Bridge Environment
# Скопируй в .env и настрой под себя

# === MQTT ===
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=sensor-bridge

# === Симуляция ===
RADAR_RANGE_NM=12.0
DEFAULT_TIMESCALE=1.0
WORLD_STATE_HZ=5.0
UPDATE_INTERVAL=0.01

# === Камера ===
CAMERA_PAN_MIN=-180
CAMERA_PAN_MAX=180
CAMERA_TILT_MIN=-30
CAMERA_TILT_MAX=30
CAMERA_ZOOM_MAX=10