# Sensor Bridge Environment Variables
# Copy this file to .env and customize values

# MQTT Broker Settings
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=sensor-bridge

# Simulation Settings
RADAR_RANGE_NM=12.0
DEFAULT_TIMESCALE=1.0
WORLD_STATE_HZ=5.0
UPDATE_INTERVAL=0.01

# GPS Emulator Settings
GPS_UPDATE_RATE=1.0
GPS_NOISE_STD=0.00001

# Radar Emulator Settings
RADAR_MIN_RANGE=0.05
RADAR_MAX_TARGETS=50
RADAR_UPDATE_INTERVAL=3.0
